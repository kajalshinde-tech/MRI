# Optional: public HTTPS origin used in QR codes and PDF certificates.
# Leave unset for local demos; localhost requests advertise the computer's LAN IP.
# NEXT_PUBLIC_SITE_URL=https://registry.example.com

# Optional server file name, stored inside .runtime/. Keep this folder on a
# persistent volume when hosting. The demo uses a single Node.js server.
# REGISTRY_FILE_NAME=registry.json
